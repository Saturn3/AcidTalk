APP_NAME=AcidTalk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8787
APP_LOCALE=it

# SQLite: avvio immediato senza DB server (file database/database.sqlite)
DB_CONNECTION=sqlite
# Per MySQL/MariaDB in produzione:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=acidtalk
# DB_USERNAME=root
# DB_PASSWORD=

# Hosting condiviso (SiteGround ecc.): log + polling. Con un VPS e Reverb attivo: reverb
BROADCAST_CONNECTION=log
# database = job in coda eseguiti dal cron (schedule:run); sync = eseguiti subito nella richiesta
QUEUE_CONNECTION=database
# true solo se hai un worker persistente (VPS con Supervisor). Su SiteGround lascia false.
QUEUE_WORKER=false
SESSION_DRIVER=database
CACHE_STORE=database

REVERB_APP_ID=acidtalk
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

FILESYSTEM_DISK=public

# --- AI providers (sovrascrivibili da Admin > Impostazioni) ---
AI_DEFAULT_PROVIDER=ollama        # ollama | openai | anthropic
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Organizzazione ---
ORG_NAME="AcidSoft"
ORG_DOMAIN=acidsoft.it
ORG_ALLOW_DOMAIN_SIGNUP=true

# --- Mail (inviti e notifiche email) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@acidsoft.it
MAIL_FROM_NAME="${APP_NAME}"

# Importazione da Zulip (facoltativa): php artisan acidtalk:import-zulip
ZULIP_URL=
ZULIP_EMAIL=
ZULIP_API_KEY=
